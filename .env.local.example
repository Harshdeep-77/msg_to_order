# Copy to .env.local and fill in (never commit .env.local)
# From Meta developer dashboard > WhatsApp > API setup
WHATSAPP_TOKEN=your_access_token
PHONE_NUMBER_ID=your_phone_number_id
# Any string you choose; enter the same in the webhook setup on Meta
VERIFY_TOKEN=edquest_verify_123
# Optional: where the SQLite file lives (default ./data/orders.db)
# DB_PATH=./data/orders.db
